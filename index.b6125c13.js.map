var inputs = document.querySelectorAll('form .field input');
inputs.forEach(function(input) {
    var inputName = input.name;
    var capitalizedText = inputName.charAt(0).toUpperCase() + inputName.slice(1);
    var label = document.createElement('label');
    label.classList.add('field-label');
    label.setAttribute('for', input.id);
    label.textContent = capitalizedText;
    input.setAttribute('placeholder', capitalizedText);
    var parentDiv = input.parentElement;
    parentDiv.insertBefore(label, input);
});

